# === Task 2 config ===
T2_DB_PATH=./data/task2.sqlite3

# === Knowledge Brain (Task 1) ===
KB_BASE_URL=http://127.0.0.1:8000
KB_BEARER_TOKEN=
KB_QUERY_TIMEOUT_MS=30000
KB_MAX_RETRIES=2
KB_BACKOFF_BASE_MS=500

# === Claude (mocked by default; live path unexercised until these are set) ===
ANTHROPIC_API_KEY=
CLAUDE_CLASSIFIER_MODEL=
CLAUDE_DRAFTER_MODEL=
CLAUDE_PROMPT_VERSION=v1

# === Delivery adapter ===
# 'simulated' is the only adapter implemented in 2A. Any other value raises at startup.
EMAIL_DELIVERY_ADAPTER=simulated
