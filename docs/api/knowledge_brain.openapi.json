{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Tech Consultant \u2014 Knowledge Brain",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "summary": "Query",
        "operationId": "query_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ingestion/run": {
      "post": {
        "summary": "Ingestion Run",
        "operationId": "ingestion_run_ingestion_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestionRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ingestion/status": {
      "get": {
        "summary": "Ingestion Status",
        "operationId": "ingestion_status_ingestion_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/escalations": {
      "post": {
        "summary": "Create Escalation",
        "operationId": "create_escalation_escalations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EscalationCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EscalationCreateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/escalations/{escalation_id}/resolve": {
      "post": {
        "summary": "Resolve Escalation",
        "operationId": "resolve_escalation_escalations__escalation_id__resolve_post",
        "parameters": [
          {
            "name": "escalation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Escalation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EscalationResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EscalationResolveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EscalationCreateRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          },
          "related_chunk_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Related Chunk Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "reason"
        ],
        "title": "EscalationCreateRequest"
      },
      "EscalationCreateResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_review",
              "resolved",
              "closed"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at"
        ],
        "title": "EscalationCreateResponse"
      },
      "EscalationResolveRequest": {
        "properties": {
          "expert_answer": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Expert Answer"
          },
          "approved_for_general_knowledge": {
            "type": "boolean",
            "title": "Approved For General Knowledge",
            "default": false
          },
          "approved_for_customer_specific": {
            "type": "boolean",
            "title": "Approved For Customer Specific",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expert_answer"
        ],
        "title": "EscalationResolveRequest"
      },
      "EscalationResolveResponse": {
        "properties": {
          "escalation_id": {
            "type": "string",
            "title": "Escalation Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "approved_for_general_knowledge": {
            "type": "boolean",
            "title": "Approved For General Knowledge"
          },
          "approved_for_customer_specific": {
            "type": "boolean",
            "title": "Approved For Customer Specific"
          },
          "approved_by": {
            "type": "string",
            "title": "Approved By"
          },
          "approved_at": {
            "type": "string",
            "title": "Approved At"
          },
          "promotion_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Promotion Run Id"
          },
          "promotion_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Promotion Error"
          }
        },
        "type": "object",
        "required": [
          "escalation_id",
          "version",
          "approved_for_general_knowledge",
          "approved_for_customer_specific",
          "approved_by",
          "approved_at"
        ],
        "title": "EscalationResolveResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthChecks": {
        "properties": {
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Db"
          },
          "embedding_provider": {
            "type": "string",
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Embedding Provider"
          },
          "vision_model": {
            "type": "string",
            "enum": [
              "ok",
              "mocked",
              "fail",
              "unconfigured"
            ],
            "title": "Vision Model"
          },
          "qa_model": {
            "type": "string",
            "enum": [
              "ok",
              "mocked",
              "fail",
              "unconfigured"
            ],
            "title": "Qa Model"
          }
        },
        "type": "object",
        "required": [
          "db",
          "embedding_provider",
          "vision_model",
          "qa_model"
        ],
        "title": "HealthChecks"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "title": "Status"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthResponse"
      },
      "ImageRef": {
        "properties": {
          "src": {
            "type": "string",
            "title": "Src"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ambiguous",
              "failed",
              "simulated"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "src",
          "status"
        ],
        "title": "ImageRef"
      },
      "IngestionRunRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "pilot"
            ],
            "title": "Mode",
            "default": "pilot"
          },
          "pilot_limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Pilot Limit",
            "default": 3
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "IngestionRunRequest"
      },
      "IngestionRunResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "already_running"
            ],
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "status",
          "message"
        ],
        "title": "IngestionRunResponse"
      },
      "IngestionStatusResponse": {
        "properties": {
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "queued",
              "running",
              "succeeded",
              "failed",
              "partial"
            ],
            "title": "Status"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "requested_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          },
          "errors": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "status"
        ],
        "title": "IngestionStatusResponse"
      },
      "QueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "insufficient_evidence",
              "failed"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer",
            "default": ""
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "type": "array",
            "title": "Sources"
          },
          "image_refs": {
            "items": {
              "$ref": "#/components/schemas/ImageRef"
            },
            "type": "array",
            "title": "Image Refs"
          },
          "escalation_required": {
            "type": "boolean",
            "title": "Escalation Required",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "question",
          "status"
        ],
        "title": "QueryResponse"
      },
      "SourceRef": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "chunk_id": {
            "type": "integer",
            "title": "Chunk Id"
          }
        },
        "type": "object",
        "required": [
          "url",
          "chunk_id"
        ],
        "title": "SourceRef"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}