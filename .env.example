# === Ingestion source ===
KB_SOURCE_DOMAIN=support.brilliantdirectories.com
KB_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml
KB_USER_AGENT=BusinessLabsTechConsultant/0.1 (+capstone; contact=set-in-env)
KB_MAX_PAGES_PER_RUN=500
KB_PILOT_LIMIT=3

# === Politeness ===
KB_CONCURRENCY=4
KB_REQUESTS_PER_SECOND=2.0
KB_REQUEST_TIMEOUT_SECONDS=30
KB_MAX_RETRIES=3
KB_BACKOFF_BASE_SECONDS=1.0
KB_BACKOFF_MAX_SECONDS=30.0

# === Storage ===
KB_DB_PATH=./data/knowledge_brain.sqlite3

# === Extraction version (bump to force re-extract of unchanged pages) ===
KB_EXTRACTION_VERSION=1

# === Anthropic (used in 1B; mocked until set) ===
ANTHROPIC_API_KEY=
KB_VISION_MODEL=
KB_QA_MODEL=

# === Milestone 1C — HTTP service ===
KB_API_TOKEN_TASK2=
KB_API_TOKEN_TASK3=
KB_API_TOKEN_ADMIN=
KB_RATE_LIMIT_PER_MINUTE=10
KB_QUERY_TIMEOUT_SECONDS=30
KB_INGESTION_REQUEST_TIMEOUT_SECONDS=2
KB_SERVICE_HOST=127.0.0.1
KB_SERVICE_PORT=8000

# === Milestone 1D — scheduler ===
KB_INGESTION_CRON_HOUR=2
KB_INGESTION_CRON_MINUTE=0
KB_REMOVED_GRACE_DAYS=30
KB_SCHEDULER_ENABLED=true
